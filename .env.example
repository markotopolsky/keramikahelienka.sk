# Analytics (lib/analytika.ts). Leave empty to run the site without analytics and without the cookie bar.
# Each one loads only after the visitor allows it in the cookie bar.
NEXT_PUBLIC_GTM_ID=          # Google Tag Manager, e.g. GTM-ABC1234
NEXT_PUBLIC_GA4_ID=          # Google Analytics 4, e.g. G-ABC123DEF4 (do not add GA4 inside GTM as well)
NEXT_PUBLIC_CLARITY_ID=      # Microsoft Clarity project ID, e.g. abc123defg

# Google Search Console, "HTML tag" verification method: only the content="..." value
GOOGLE_SITE_VERIFICATION=

# Simple CMS (README, "Editovateľný obsah"). Without them the site shows the texts and products from the code.
NEXT_PUBLIC_SUPABASE_URL=            # Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Supabase → Project Settings → API → anon public key
SUPABASE_SERVICE_ROLE_KEY=           # seed scripts and the checkout (lib/supabase-admin.ts); on the hosting only as a server variable, never NEXT_PUBLIC_

# Cloudinary. Without the cloud name the photos are served from public/images without optimisation.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=   # the cloud name from CLOUDINARY_URL (cloudinary://key:secret@<cloud name>)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET= # unsigned preset for uploads from /admin, e.g. keramikahelienka_unsigned
CLOUDINARY_URL=                      # only for scripts (cloudinary-upload.mjs, setup:cloudinary); replaces CLOUDINARY_API_KEY + CLOUDINARY_API_SECRET
